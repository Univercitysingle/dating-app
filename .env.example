# Serverless / Backend Configuration
PORT=8080
MONGO_URI="mongodb+srv://user:password@cluster.mongodb.net/datingapp?retryWrites=true&w=majority"
JWT_SECRET=your_jwt_secret
CRON_SECRET=your_secure_cron_secret_key
ENABLE_IN_PROCESS_CRON=true

# Superadmin Configuration
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=your_super_admin_password
# Optional: Use bcrypt hash instead of plaintext password for superadmin
# SUPER_ADMIN_PASSWORD_HASH="$2a$10$..."

# Geolocation (IPinfo.io)
IPINFO=your_ipinfo_api_token

# CDN Configuration
CDN_HOSTNAME=your_cdn_hostname.example.com

# WebXPay Configuration
WEBXPAY_SECRET_KEY=your_webxpay_secret_key
WEBXPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# AWS / Backblaze S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_aws_region

# Firebase Admin SDK Configuration (Serverless Realtime & Auth)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FIREBASE_DATABASE_URL=https://your_firebase_project_id-default-rtdb.firebaseio.com

# Frontend Configuration
FRONTEND_URL="https://universitysingle.duckdns.org"
REACT_APP_API_BASE_URL="https://universitysingle.duckdns.org/api"
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://universitysingle.duckdns.org

# Frontend Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
REACT_APP_FIREBASE_PROJECT_ID=your_firebase_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id
REACT_APP_FIREBASE_DATABASE_URL=https://your_firebase_project_id-default-rtdb.firebaseio.com