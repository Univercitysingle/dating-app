{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dating-app-face-verification-staging",
  "main": "index.js",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "containers": [
    {
      "class_name": "FaceApiContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 2,
      "observability": { "enabled": true }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "FACE_ENGINE", "class_name": "FaceApiContainer" }
    ]
  },
  "exports": {
    "FaceApiContainer": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "ALLOWED_PHOTO_ORIGIN": "https://dateme.enadoctemp.workers.dev"
  }
}
